#!/usr/bin/env bash
# install-cli — find or download the release CLI this plugin pins, and print
# its absolute path.
#
#   bash install-cli <plugin-data-dir>
#
# The pinned version is the `version` of .claude-plugin/plugin.json three
# directories above this script, and nothing else. Lookup, first hit wins and
# fetches nothing:
#
#   1. RELEASE_CLI, a path to an executable (relative to the git toplevel of
#      the working directory). Not executable is a failure, never a fall-through.
#   2. <data-dir>/bin/<version>/release (release.exe on windows).
#   3. `release` on the PATH, when `release --version` prints release v<version>.
#
# Otherwise the release archive for this platform is downloaded from the
# GitHub API with SHA256SUMS, verified, extracted with tar and moved into
# <data-dir>/bin/<version>/. With CLAUDE_CODE_REMOTE=true the provisioned
# binary is also linked as `release` into /usr/local/bin.
#
# Credential: GH_TOKEN, else GITHUB_TOKEN, else `gh auth token`, else none.
# It is sent as a header read from standard input, to the API host only:
# curl -L without --location-trusted drops it on a redirect to another host.
# It never reaches a command line, the output or a file.
#
# Test seams: INSTALL_CLI_API_URL (default https://api.github.com) and
# INSTALL_CLI_LINK_DIR (default /usr/local/bin).
#
# Exit status: 0 with the path as the only line of standard output; 1 with one
# line `install-cli: <cause>. <remedy>` on standard error; 2 on bad usage.
# POSIX tools only: no jq, Python or Go.
set -u

REPO=brettcallaghan/release

fail() {
  printf 'install-cli: %s. %s\n' "$1" "$2" >&2
  exit 1
}

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo "usage: bash install-cli <plugin-data-dir>" >&2
  exit 2
fi
data="$1"
case "$data" in
  /*) ;;
  *) data="$PWD/$data" ;;
esac

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
manifest="$script_dir/../../../.claude-plugin/plugin.json"
version=""
if [ -r "$manifest" ]; then
  version="$(sed -n 's/^.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*$/\1/p' "$manifest")"
  version="${version%%[[:space:]]*}"
fi
[ -n "$version" ] ||
  fail "no version in $manifest" "reinstall the release plugin"

# Platform. A platform with no archive fails only when a download is needed.
os=""
case "$(uname -s 2>/dev/null)" in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  MINGW* | MSYS* | CYGWIN*) os=windows ;;
esac
arch=""
case "$(uname -m 2>/dev/null)" in
  x86_64 | amd64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
esac
exe=release
[ "$os" = windows ] && exe=release.exe

dest_dir="$data/bin/$version"
dest="$dest_dir/$exe"

# Link the provisioned binary for every process in a cloud session.
link_and_print() {
  if [ "${CLAUDE_CODE_REMOTE:-}" = true ]; then
    link_dir="${INSTALL_CLI_LINK_DIR:-/usr/local/bin}"
    ln -sf "$1" "$link_dir/release" 2>/dev/null ||
      fail "cannot link release into $link_dir" "make $link_dir writable, or run release by the path this script prints"
  fi
  printf '%s\n' "$1"
  exit 0
}

# 1. The repository's own build.
if [ -n "${RELEASE_CLI:-}" ]; then
  cli="$RELEASE_CLI"
  case "$cli" in
    /*) ;;
    *)
      top="$(git rev-parse --show-toplevel 2>/dev/null)" || top="$PWD"
      cli="$top/$cli"
      ;;
  esac
  if [ -f "$cli" ] && [ -x "$cli" ]; then
    printf '%s\n' "$cli"
    exit 0
  fi
  fail "RELEASE_CLI is not an executable: $cli" "fix or unset RELEASE_CLI"
fi

# 2. Already provisioned.
if [ -f "$dest" ] && [ -x "$dest" ]; then
  link_and_print "$dest"
fi

# 3. On the PATH at the pinned version.
if found="$(command -v release 2>/dev/null)" && [ -n "$found" ]; then
  reported="$("$found" --version 2>/dev/null)"
  if [ "$reported" = "release v$version" ]; then
    printf '%s\n' "$found"
    exit 0
  fi
fi

# Download.
[ -n "$os" ] && [ -n "$arch" ] ||
  fail "no release archive for $(uname -s 2>/dev/null)/$(uname -m 2>/dev/null)" \
    "use linux, darwin or windows on amd64 or arm64"
ext=tar.gz
[ "$os" = windows ] && ext=zip
archive="release_${version}_${os}_${arch}.$ext"

command -v curl >/dev/null 2>&1 ||
  fail "curl is not on the PATH" "install curl"

api="${INSTALL_CLI_API_URL:-https://api.github.com}"
api="${api%/}"

token="${GH_TOKEN:-}"
[ -n "$token" ] || token="${GITHUB_TOKEN:-}"
if [ -z "$token" ] && command -v gh >/dev/null 2>&1; then
  token="$(gh auth token 2>/dev/null)" || token=""
fi

tmp="$data/bin/.tmp-$$"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
mkdir -p "$tmp" ||
  fail "cannot create $tmp" "make $data writable"

# get <url> <accept> <out-file>: prints the final HTTP status; the curl exit
# status is the function's. The credential goes on standard input only.
get() {
  if [ -n "$token" ]; then
    printf 'Authorization: Bearer %s\n' "$token" |
      curl -sS -L --connect-timeout 30 -H @- -H "Accept: $2" \
        -o "$3" -w '%{http_code}' "$1" 2>/dev/null
  else
    curl -sS -L --connect-timeout 30 -H "Accept: $2" \
      -o "$3" -w '%{http_code}' "$1" 2>/dev/null
  fi
}

# fetch <url> <accept> <out-file> <what>: get, mapping failures to causes.
fetch() {
  status="$(get "$1" "$2" "$3")" ||
    fail "the release v$version cannot be reached ($4)" \
      "check that the session can reach api.github.com"
  case "$status" in
    2??) ;;
    401 | 403 | 404)
      fail "the release v$version is not readable (HTTP $status for $4)" \
        "set GH_TOKEN to a token that can read $REPO, or run gh auth login" ;;
    *)
      fail "the release v$version cannot be reached (HTTP $status for $4)" \
        "check that the session can reach api.github.com" ;;
  esac
}

fetch "$api/repos/$REPO/releases/tags/v$version" \
  "application/vnd.github+json" "$tmp/release.json" "the release"

# Each asset's own "name" and "id", one "name<TAB>id" line per asset: the
# objects one level inside the release object. A small scanner rather than a
# pattern, so neither key order, whitespace nor a nested object (an asset's
# uploader has an id) can pair a name with the wrong id.
assets="$(awk '
  { doc = doc $0 "\n" }
  END {
    n = length(doc); depth = 0; instr = 0; esc = 0; val = 0
    for (i = 1; i <= n; i++) {
      c = substr(doc, i, 1)
      if (instr) {
        if (esc) { buf = buf c; esc = 0 }
        else if (c == "\\") { buf = buf c; esc = 1 }
        else if (c == "\"") {
          instr = 0
          if (val) { if (key == "name") nm[depth] = buf; val = 0 }
          else last = buf
        }
        else buf = buf c
        continue
      }
      if (c == "\"") { instr = 1; buf = "" }
      else if (c == ":") { key = last; val = 1 }
      else if (c == "{") { depth++; nm[depth] = ""; id[depth] = ""; val = 0 }
      else if (c == "}") {
        if (depth == 2 && nm[depth] != "" && id[depth] != "") print nm[depth] "\t" id[depth]
        depth--; val = 0
      }
      else if (c == "," || c == "[" || c == "]") val = 0
      else if (val && key == "id" && c ~ /[0-9]/) id[depth] = id[depth] c
    }
  }' "$tmp/release.json")"

asset_id() {
  printf '%s\n' "$assets" | awk -F '\t' -v n="$1" '$1 == n { print $2; exit }'
}
archive_id="$(asset_id "$archive")"
sums_id="$(asset_id SHA256SUMS)"
[ -n "$archive_id" ] ||
  fail "no release archive for $os/$arch in release v$version" \
    "use linux, darwin or windows on amd64 or arm64"
[ -n "$sums_id" ] ||
  fail "checksum mismatch for $archive: release v$version has no SHA256SUMS" \
    "retry; a repeated mismatch is a corrupted release to report"

fetch "$api/repos/$REPO/releases/assets/$sums_id" \
  "application/octet-stream" "$tmp/SHA256SUMS" "SHA256SUMS"
fetch "$api/repos/$REPO/releases/assets/$archive_id" \
  "application/octet-stream" "$tmp/$archive" "$archive"

# Verify before anything reads the archive.
want="$(awk -v n="$archive" '$2 == n || $2 == "*" n { print $1; exit }' "$tmp/SHA256SUMS")"
if command -v sha256sum >/dev/null 2>&1; then
  got="$(sha256sum "$tmp/$archive" | awk '{ print $1 }')"
elif command -v shasum >/dev/null 2>&1; then
  got="$(shasum -a 256 "$tmp/$archive" | awk '{ print $1 }')"
else
  rm -f "$tmp/$archive"
  fail "neither sha256sum nor shasum is on the PATH to verify $archive" \
    "install coreutils or perl's shasum"
fi
if [ -z "$want" ] || [ "$want" != "$got" ]; then
  rm -f "$tmp/$archive"
  fail "checksum mismatch for $archive" \
    "retry; a repeated mismatch is a corrupted release to report"
fi

mkdir -p "$tmp/x" &&
  if [ "$ext" = zip ]; then
    tar -xf "$tmp/$archive" -C "$tmp/x"
  else
    tar -xzf "$tmp/$archive" -C "$tmp/x"
  fi >/dev/null 2>&1 ||
  fail "cannot extract $archive" "retry; a repeated failure is a corrupted release to report"
[ -f "$tmp/x/$exe" ] ||
  fail "$archive holds no $exe" "retry; a repeated failure is a corrupted release to report"

mkdir -p "$dest_dir" &&
  chmod 755 "$tmp/x/$exe" &&
  mv -f "$tmp/x/$exe" "$dest" ||
  fail "cannot place $exe in $dest_dir" "make $data writable"

link_and_print "$dest"
